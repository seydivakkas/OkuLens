{
  "manifest_version": 3,
  "name": "OkuLens",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "Makale, e-posta ve YouTube içeriğinde hibrit yerel NLP ve koşullu yerleşik AI ile gizlilik odaklı özetleme.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "action": {
    "default_title": "OkuLens yan panelini aç"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "optional_host_permissions": [
    "https://huggingface.co/*",
    "https://us.aws.cdn.hf.co/*"
  ]
}
